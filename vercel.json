{
  "version": 2,
  "installCommand": "cd backend && npm install",
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "home/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/",
      "dest": "home/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "home/$1"
    }
  ]
}
